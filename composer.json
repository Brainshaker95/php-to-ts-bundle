{
  "name": "brainshaker95/php-to-ts-bundle",
  "description": "Convert PHP model classes to TypeScript interfaces",
  "version": "0.5.0",
  "keywords": [
    "bundle",
    "symfony",
    "php",
    "typescript"
  ],
  "type": "symfony-bundle",
  "license": "MIT",
  "authors": [
    {
      "name": "Patrick Rupp"
    }
  ],
  "require": {
    "php": ">=8.1",
    "ext-ctype": "*",
    "ext-filter": "*",
    "ext-json": "*",
    "ext-tokenizer": "*",
    "nikic/php-parser": "^5.0",
    "phpdocumentor/reflection-docblock": "^5.6",
    "phpstan/phpdoc-parser": "^1.33",
    "symfony/config": "^5.0 || ^6.0 || ^7.0",
    "symfony/console": "^5.0 || ^6.0 || ^7.0",
    "symfony/dependency-injection": "^5.0 || ^6.0 || ^7.0",
    "symfony/event-dispatcher": "^5.0 || ^6.0 || ^7.0",
    "symfony/filesystem": "^5.0 || ^6.0 || ^7.0",
    "symfony/finder": "^5.0 || ^6.0 || ^7.0",
    "symfony/http-foundation": "^5.0 || ^6.0 || ^7.0",
    "symfony/http-kernel": "^5.0 || ^6.0 || ^7.0",
    "symfony/property-access": "^5.0 || ^6.0 || ^7.0",
    "symfony/serializer": "^5.0 || ^6.0 || ^7.0",
    "symfony/string": "^5.0 || ^6.0 || ^7.0"
  },
  "require-dev": {
    "ext-dom": "*",
    "ext-libxml": "*",
    "ext-mbstring": "*",
    "ext-phar": "*",
    "ext-xml": "*",
    "ext-xmlwriter": "*",
    "cweagans/composer-patches": "1.7.3",
    "friendsofphp/php-cs-fixer": "3.62.0",
    "kubawerlos/php-cs-fixer-custom-fixers": "3.21.0",
    "phpat/phpat": "0.10.20",
    "phpstan/extension-installer": "1.4.3",
    "phpstan/phpstan": "1.12.32",
    "phpstan/phpstan-strict-rules": "1.6.2",
    "phpunit/phpunit": "11.5.42",
    "rector/type-perfect": "0.1.8",
    "symfony/error-handler": "7.3.4",
    "symfony/framework-bundle": "7.3.4",
    "symfony/yaml": "7.3.3",
    "symplify/phpstan-rules": "13.0.1"
  },
  "autoload": {
    "psr-4": {
      "Brainshaker95\\PhpToTsBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "cweagans/composer-patches": true,
      "phpstan/extension-installer": true
    }
  },
  "extra": {
    "patches-file": "composer-patches.json"
  }
}
